*** Alerts ***
to = root@localhost
from = smokeping@localhost

# Windows below are in *cycles*; with a 10 s step, 6 cycles = 1 minute.

# --- host reachability -------------------------------------------------
+hostdown
type = loss
pattern = >90%,>90%,>90%,>90%,>90%,>90%
comment = Host unreachable - >90% packet loss for ~1 minute
priority = 1

# --- packet loss ------------------------------------------------------
+majorloss
type = matcher
pattern = ConsecutiveLoss(pctlossraise=>25,stepsraise=>6,pctlossclear=>3,stepsclear=>12)
comment = Major packet loss - 25%+ sustained for ~1 minute
priority = 2

+lossdetect
type = matcher
pattern = ConsecutiveLoss(pctlossraise=>10,stepsraise=>18,pctlossclear=>3,stepsclear=>30)
comment = Sustained packet loss - 10%+ for ~3 minutes
priority = 6

# --- latency --------------------------------------------------------
+latencyhigh
type = matcher
pattern = CheckLatency(l=>300,x=>18)
comment = Round-trip latency above 300 ms for ~3 minutes
priority = 10

+latencyshift
type = matcher
pattern = Avgratio(historic=>60,current=>18,comparator=>'>',percentage=>200)
comment = Latency more than doubled versus the last ~10 minutes
priority = 15
