# Copy to .env and adjust for your host.
BASE_TAG=latest
PUID=99
PGID=100
TZ=Europe/Amsterdam

# Where SmokePing keeps its config and its rrd data on the host.
CONFIG_DIR=/mnt/user/appdata/smokeping/config
DATA_DIR=/mnt/user/appdata/smokeping/data

# Host port to publish (container listens on 80). Unraid already uses 80/443.
HTTP_PORT=8480

# Login for the web UI / API / classic CGI. WEBUI_AUTH=off to disable.
# Leave WEBUI_PASS empty to get a generated password (see container log or
# /config/modern-auth/password.txt).
WEBUI_AUTH=on
WEBUI_USER=admin
WEBUI_PASS=
